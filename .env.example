# =============================================================================
# agentplain Phase 1 — environment variables
# =============================================================================
# Tier rules per feedback_no_prod_secrets_in_dev:
#   * Production-tier secrets (signing keys, prod DB creds, prod API keys)
#     live in Production Vercel only.
#   * Preview gets separate values (preview DB, Stripe test keys).
#   * Development gets local values that fail loudly if missing.
#
# This file is the SHAPE only — never check actual values into git.

# -- Database -----------------------------------------------------------------
DATABASE_URL="postgresql://user:pass@localhost:5432/agentplain_dev?schema=public"
# Pooled URL for runtime queries (Neon pgbouncer endpoint in production).
DATABASE_POOL_URL="postgresql://user:pass@localhost:5432/agentplain_dev?schema=public&pgbouncer=true"

# -- Auth / sessions ----------------------------------------------------------
# 32+ char random string, separate per env. Production-tier in production only.
SESSION_PASSWORD="dev-only-replace-in-real-environments-with-32-plus-byte-random"
SESSION_COOKIE_NAME="agentplain_session"
# Public origin used in magic-link emails. Should match how the user reaches the app.
APP_PUBLIC_ORIGIN="http://localhost:3000"

# -- Resend (magic-link delivery) --------------------------------------------
RESEND_API_KEY=""
RESEND_FROM_EMAIL="agentplain <claude@agentplain.com>"

# -- Stripe (Phase 1 pipes-ready, manual invoicing for first ~5 brokerages) ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_TIER_1="price_REPLACE"   # flatsbo-pilot-tier-1 ($1500/30d)
STRIPE_PRICE_TIER_2="price_REPLACE"   # flatsbo-pilot-tier-2 ($2750)
STRIPE_PRICE_TIER_3="price_REPLACE"   # flatsbo-pilot-tier-3 ($4500)
STRIPE_PRICE_TIER_1_ANNUAL="price_REPLACE"
STRIPE_PRICE_TIER_2_ANNUAL="price_REPLACE"
STRIPE_PRICE_TIER_3_ANNUAL="price_REPLACE"

# -- Notion (briefing read-through cache, operator-internal canonical) -------
NOTION_API_KEY=""
# Notion 2025-09 API: data source id (NOT database id). Get it from
# `client.databases.retrieve(databaseId).data_sources[0].id` once.
NOTION_BRIEFINGS_DATA_SOURCE_ID=""

# -- Adapter selection (test/dev can swap to in-memory impls) ----------------
# auth: 'resend' | 'test'
AUTH_PROVIDER="resend"
# billing: 'stripe' | 'test'
BILLING_PROVIDER="stripe"
# briefings: 'notion' | 'test'
BRIEFINGS_PROVIDER="notion"

# -- Operator allowlist (platform-flag bootstrap) ----------------------------
# Comma-separated emails granted is_operator=true at first sign-in. Production-tier.
OPERATOR_EMAIL_ALLOWLIST=""

# -- Health readiness probe --------------------------------------------------
# Gates GET /api/health/ready, which runs the db + inngest dependency checks.
# FAILS CLOSED: when this is empty the route returns 503 "unconfigured"
# WITHOUT touching the database. That default is deliberate — an
# unauthenticated DB-touching probe is what exhausted the Neon Free compute
# allowance (110.08/100 CU-hr) and paused the project.
#
# GET /api/health is liveness only, makes no DB call, and needs no token —
# that is the path to point an uptime monitor at.
#
#   curl -H "x-health-token: <value>" https://agentplain.com/api/health/ready
#
# Generate with: openssl rand -hex 32
HEALTH_READY_TOKEN=""

# -- Sentry (runtime error reporting) ----------------------------------------
# Production-tier per feedback_no_prod_secrets_in_dev. Leave empty in dev /
# preview; the observability adapter falls back to a noop reporter and the
# Sentry SDK init becomes a no-op. Add real DSN in Vercel Production env only.
SENTRY_DSN=""
# Same DSN exposed to the browser bundle. Sentry DSNs are public-by-design
# (they only authorize ingest, not read), but we still keep it gated on prod
# so dev/preview don't ship a client-side init pointing at a non-existent
# project. When unset, the client-side Sentry.init is skipped.
NEXT_PUBLIC_SENTRY_DSN=""
# Optional Sentry org/project — used by withSentryConfig if/when we wire
# source-map upload. Auth token (SENTRY_AUTH_TOKEN) is Conner-only and lives
# in Vercel Production. Leave commented out until source maps are wired.
# SENTRY_ORG=""
# SENTRY_PROJECT=""
