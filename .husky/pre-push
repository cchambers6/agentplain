#!/usr/bin/env sh
# Pre-push hook — staleness gate + full-repo lint + build gate.
#
# Layer 0 (staleness gate): refuse pushes when the branch BEING PUSHED is too far behind
# origin/main. Stale-base branches keep tripping Vercel preview lint with errors that are
# already fixed on main (see ~/.claude/projects/C--agentplain/memory/feedback_code_tasks_rebase_first.md).
# Threshold is 5 commits — small enough to catch genuinely stale branches (the cases that
# triggered this rule were 10+ behind), large enough to not nag on every-day work.
# Emergency escape hatch: SKIP_PREPUSH_REBASE_GATE=1 git push ...
#
# 2026-09-14: the check is unchanged; its SUBJECT was wrong. It measured `HEAD..origin/main`,
# and HEAD is whatever the checkout happens to be parked on — not the branch being pushed,
# whenever that branch was authored in a separate worktree or built through a temporary
# GIT_INDEX_FILE, which is the normal case on the fleet machine. With that checkout parked 79
# commits behind, every correctly rebased push was refused, and the more correctly a session
# worked the more surely it fired. Git hands pre-push the refs actually being pushed on stdin
# (`<local ref> <local sha> <remote ref> <remote sha>`, one line per ref); the gate now
# measures those. Logic moved to tools/prepush-staleness-gate.mjs so the two cases that matter
# — a stale branch is rejected, a correctly based branch is accepted — are pinned by
# tests/prepush-staleness-gate.test.ts instead of argued about. THE GATE WAS NOT LOOSENED:
# threshold, reason and escape hatch are all unchanged.
#
# Layer 1 (full-repo lint): belt-and-suspenders against the per-file pre-commit pass.
# Catches cross-file rule violations and bypassed pre-commits.
# Bypass with `git push --no-verify` only in genuine emergencies; document why in the commit.
# See outputs/systematic_main_protection/design.md §Layer 1.
#
# Layer 2 (build gate): refuse pushes that don't compile. Added 2026-05-18 after
# shipping broken main twice in one week — a TS error in `scripts/verify-knowledge-seed.ts`
# and the verify-page cookie crash both landed because the pre-push pipeline only ran
# lint, not the full Next.js build. `build:no-migrate` is the build command without the
# Prisma `migrate deploy` step, so it's safe to run from any developer machine and
# doesn't require a live DATABASE_URL.
#
# 2026-09-14: Layer 2 is now OPT-IN (PREPUSH_BUILD_GATE=1) rather than always-on, and the
# protection it provided moved to .github/workflows/build-gate.yml. The reason is not that the
# check is unwanted — it is that on the 16 GB fleet machine `next build` cannot reliably
# complete: OOM has been measured at 4, 6, 8 AND 12 GB heap ceilings, because the variable is
# free RAM, not the ceiling. An always-on gate that cannot run is not protection, it is a wall
# that pushes people to HUSKY=0 — which turns off EVERY layer in this file, including
# check:claims, which appears in NO workflow and is enforced here and nowhere else.
# WHAT MOVED, EXACTLY: a TS/compile error is now caught by the build-gate workflow (blocking,
# on every PR and every push to main) and by the Vercel preview build (which already runs
# `npm run build` on every pushed branch — verified 2026-09-14 against the deployments list),
# instead of before the push leaves the machine. Cost: the feedback arrives minutes later and
# after the commit exists, not before. Nothing reaches main uncompiled either way.
# Machines that CAN run a build should set PREPUSH_BUILD_GATE=1 in their shell profile to keep
# the fast local signal.

# --- Layer 0: staleness gate ---
# Reads the pushed refs from stdin. Must come first: nothing downstream reads stdin,
# and this consumes it.
node tools/prepush-staleness-gate.mjs || exit 1

# --- Layer 1: lint ---
npm run lint || exit 1

# --- Layer 1.5: brand gate (fast, dependency-free) ---
# Vendor names / placeholder assets / token drift / banned words on customer
# surfaces. Baseline ratchet — only NEW violations fail. Wired 2026-06-11 once
# the design-remediation waves drove the baseline to zero (PRs #227-#234).
npm run brand-gate || {
  echo "❌ Push blocked: brand-gate found new brand-standard violations (see docs/brand/brand-gate.md)."
  exit 1
}

# --- Layer 1.5: voice gate (de-AI-fication) ---
# Companion to brand-gate. brand-gate owns HYPE (R4: supercharge, seamless, …);
# voice-gate owns LLM-ESE — the mechanical tells of machine-written prose
# (delve/tapestry vocabulary, "not just X — it's Y" antithesis, "Great question!"
# chatbot openers, and em-dash spam). Baseline ratchet — only NEW tics fail.
# Wired 2026-06-19. Catalog: docs/brand/voice-guidelines-2026-06-19.md §3.
npm run voice-gate || {
  echo "❌ Push blocked: voice-gate found new AI-tics in customer copy."
  echo "   See docs/brand/voice-guidelines-2026-06-19.md §3, or allowlist an intentional usage in tools/brand/voice-gate-allow.json."
  exit 1
}

# --- Layer 1.6: connector dispatch-coverage gate (fast, dependency-free) ---
# Every marketplace connector marked status:"available" must have a live MCP
# dispatch route at app/api/integrations/<slug>/[workspaceId]/route.ts. Wired
# 2026-06-15 after the click-path triage found HubSpot/Salesforce/Notion/FUB/
# Sierra/Buildium connected + synced but had no dispatch route — so every agent
# action through them silently 404'd ("every button feels broken").
npm run check:connector-dispatch || {
  echo "❌ Push blocked: a connectable connector is missing its MCP dispatch route."
  echo "   Add the route, or mark the connector status:\"coming-soon\" in lib/integrations/marketplace.ts."
  exit 1
}

# --- Layer 1.7: claim-vs-code checks (fast, in-process) ---
# Three separate findings across the 2026-08-10 and 2026-08-11 audits were the
# same drift: a customer surface claims something the code cannot do. A fleet
# card renders "Watching — ready when triggered" for a skill nothing can
# trigger; a connector tile sells an action the connect flow never requests a
# scope for; the signup gate and the readiness resolver disagree about who can
# be charged. All three are silent at runtime — no error, no log, just a
# surface that lies.
#
# Deliberately NOT the full suite. `npm run test:gate` (5,900+ tests, ~7 min)
# is enforced in CI (.github/workflows/tests.yml) because adding it on top of
# the build gate below would push people toward HUSKY=0 — which turns off
# EVERY layer in this file. This is the sub-second slice worth paying for
# locally; CI is the enforcement point.
#
# NOTE (2026-09-14): this check is enforced HERE AND NOWHERE ELSE — it appears in no
# workflow. That is what makes HUSKY=0 expensive, and is the main reason Layer 2 became
# opt-in rather than staying a wall people route around.
npm run check:claims || {
  echo "❌ Push blocked: a customer surface claims something the code cannot do."
  echo "   See lib/claims/capability-claims.ts for what each check asserts."
  echo "   Accepting a violation on purpose needs a dated entry in lib/claims/known-drift.ts."
  exit 1
}

# --- Layer 2: build gate (opt-in — see the header note) ---
if [ "${PREPUSH_BUILD_GATE:-0}" = "1" ]; then
  echo ""
  echo "▶ Running build gate (npm run build:no-migrate) — catches TS errors + broken pages before push."
  echo ""
  npm run build:no-migrate || {
    echo ""
    echo "❌ Push blocked: build:no-migrate failed."
    echo "   Fix the build before pushing."
    echo ""
    exit 1
  }
else
  echo "ℹ Local build gate off (PREPUSH_BUILD_GATE != 1). Compile errors are caught by"
  echo "  .github/workflows/build-gate.yml and the Vercel preview build. Set PREPUSH_BUILD_GATE=1"
  echo "  to run it locally on a machine with the headroom."
fi

# --- Layer 3: schema-drift gate with raw-index auto-heal (Wave-7, theme #19) ---
# When a SHADOW_DATABASE_URL is available, run the drift check in auto-heal
# mode. If the only drift is a new raw-SQL index migration (GIN/trgm/pgvector),
# the check appends the DROP INDEX line to prisma/schema-drift-baseline.sql
# automatically — the documented fix — instead of leaving HUSKY=0 as the only
# way forward. ANY other drift still fails loud (the gate is NOT weakened).
# Skipped entirely when no shadow DB is configured (the common local case),
# so this never blocks a push on a machine without Postgres and never
# interferes with a parallel wave's push.
if [ -n "${SHADOW_DATABASE_URL:-}" ]; then
  echo ""
  echo "▶ Running schema-drift gate (auto-heals raw-index drift; other drift fails loud)."
  npm run check:schema-drift -- --auto-heal-raw-indexes || {
    echo ""
    echo "❌ Push blocked: schema drift beyond the known raw-index pattern."
    echo "   Resolve with 'npx prisma migrate dev' or '--update-baseline' + a README note."
    echo "   (Do NOT use HUSKY=0 — that is the jailbreak this gate exists to remove.)"
    echo ""
    exit 1
  }
  # If the auto-heal modified the baseline, the push would otherwise ship a
  # dirty working tree. Surface it so the developer commits the healed file.
  if ! git diff --quiet -- prisma/schema-drift-baseline.sql; then
    echo ""
    echo "❌ Push blocked: schema-drift auto-heal updated prisma/schema-drift-baseline.sql."
    echo "   Review + commit the healed baseline, then push again:"
    echo "     git add prisma/schema-drift-baseline.sql && git commit --amend --no-edit"
    echo ""
    exit 1
  fi
fi
